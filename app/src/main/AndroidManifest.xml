<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Optional "scan whole device" mode only. The default path is the Storage
        Access Framework folder picker, which needs no permission at all.
        This is a special access grant: the user must toggle it in system
        Settings, it cannot be granted from a runtime dialog, and Play Store
        distribution would require a declared exemption.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!--
        ML Kit downloads its Catalan and English translation models on first use.
        Translation itself runs entirely on-device afterwards; this is only for
        fetching the models.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".LlegeixApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Llegeix">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Llegeix"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
