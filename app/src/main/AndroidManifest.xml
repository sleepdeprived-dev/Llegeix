<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Optional "scan whole device" mode only. The default path is the Storage
        Access Framework folder picker, which needs no permission at all.
        This is a special access grant: the user must toggle it in system
        Settings, it cannot be granted from a runtime dialog, and Play Store
        distribution would require a declared exemption.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!--
        Three things, and no more.

        ML Kit downloads its Catalan, Romanian and English translation models on
        first use; translation itself runs entirely on-device afterwards. The
        flashcard form looks for pictures of the word being written — ARASAAC
        for pictograms, Wikimedia Commons and Openverse for photographs — and
        only while a card is open and only after a pause in the typing. And
        Configuració's update check asks GitHub what the newest release is.

        None of the three carries an account, an identifier, or anything about
        the reader or their documents; the picture search is the only one that
        sends a word, and it is the word being typed onto the card. All of it is
        set out in the privacy policy the app shows in Configuració.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Configuració's "check for updates" button. The app is sideloaded rather
        than installed from a store, so nothing else would ever update it.

        This is the right to *ask*: the APK is handed to Android's own package
        installer, which shows its own dialog and is the only thing that can
        actually install anything. The reader must also grant this app as a
        source in system Settings before the dialog will appear at all.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        Which speech engine can say a Catalan word.

        Since Android 11 an app sees only the other apps it declares an
        interest in, and a text-to-speech engine is another app. Without this
        the system reports that the device has no voice at all and the speaker
        button never appears. It is a visibility declaration and nothing more:
        no permission, and nothing leaves the device — the speech is synthesised
        by the engine already installed on the phone.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.tts.engine.INSTALL_TTS_DATA" />
        </intent>
    </queries>

    <application
        android:name=".LlegeixApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Llegeix">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Llegeix"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Hands a downloaded update to the package installer.

            A content URI rather than a file one, because a file:// URI to
            another app has been an offence since Android 7. Not exported: the
            only thing that ever reads through it is the installer, and only for
            the one intent that grants it read permission on the way.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>

</manifest>
