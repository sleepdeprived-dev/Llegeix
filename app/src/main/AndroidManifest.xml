<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Optional "scan whole device" mode only. The default path is the Storage
        Access Framework folder picker, which needs no permission at all.
        This is a special access grant: the user must toggle it in system
        Settings, it cannot be granted from a runtime dialog, and Play Store
        distribution would require a declared exemption.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!--
        Two things, and no more.

        ML Kit downloads its Catalan and English translation models on first
        use; translation itself runs entirely on-device afterwards. And
        Configuració's update button asks GitHub what the newest release is,
        when it is pressed and never otherwise. Neither request carries anything
        about the reader or their documents.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Configuració's "check for updates" button. The app is sideloaded rather
        than installed from a store, so nothing else would ever update it.

        This is the right to *ask*: the APK is handed to Android's own package
        installer, which shows its own dialog and is the only thing that can
        actually install anything. The reader must also grant this app as a
        source in system Settings before the dialog will appear at all.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".LlegeixApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Llegeix">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Llegeix"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Hands a downloaded update to the package installer.

            A content URI rather than a file one, because a file:// URI to
            another app has been an offence since Android 7. Not exported: the
            only thing that ever reads through it is the installer, and only for
            the one intent that grants it read permission on the way.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>

</manifest>
