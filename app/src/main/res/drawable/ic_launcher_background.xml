<!--
    A deep warm charcoal behind the artwork.

    The book is red, gold and green and its own outer edge is bright red, so a
    red or burgundy ground would swallow the spine. Charcoal is neutral enough
    to let all three colours read, and dark enough that the icon holds its shape
    on a pale wallpaper as well as a dark one. Solid rather than a gradient: at
    48dp a gradient is invisible, and launchers treat a flat background more
    predictably.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:fillColor="#241B1C" android:pathData="M0,0 h108 v108 h-108 z" />
</vector>
