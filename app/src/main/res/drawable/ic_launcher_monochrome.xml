<!--
    The themed-icon layer: one flat shape, tinted by the launcher.

    Deliberately not the full artwork reduced. A themed icon is painted in a
    single colour, so stripes and a spiral would collapse into a blob; this keeps
    only the silhouette that identifies the app — a book with a bloom on it,
    with the bloom knocked out of the cover so both stay legible.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
        Framed like the raster layer, and inside the circle with it. At the size
        this was drawn the book stood 51 by 56dp, which puts its corners 38dp
        from the middle of the canvas — outside the 36dp circle a round mask
        leaves, so the very corners of the cover were being shaved off. Scaled
        to bring them to 34dp, which is inside it with a little to spare, and
        which leaves the themed icon and the full-colour one at much the same
        size in the same launcher.
    -->
    <group
        android:pivotX="51.5"
        android:pivotY="54"
        android:scaleX="0.84"
        android:scaleY="0.84"
        android:translateX="2.5">
        <path
            android:fillColor="#FFFFFF"
            android:fillType="evenOdd"
            android:pathData="M27,24 h49 a3,3 0 0 1 3,3 v54 a3,3 0 0 1 -3,3 h-49 a3,3 0 0 1 -3,-3 v-54 a3,3 0 0 1 3,-3 z M57,50 m-15,0 a15,15 0 1 0 30,0 a15,15 0 1 0 -30,0" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M57,50 m-9,0 a9,9 0 1 0 18,0 a9,9 0 1 0 -18,0" />
    </group>
</vector>
