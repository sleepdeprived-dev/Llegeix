<!--
    Llegeix: a book in the Senyera, with a Sant Jordi rose.

    Redrawn as vectors from the original raster artwork, and composed for the
    size it is actually seen at. Three things were fixed against the first
    attempt: the cover is portrait rather than square, so it reads as a book and
    not as a flag; the rose sits on a cream medallion, because a dark red bloom
    laid straight over red stripes disappears at 48dp; and the page block is a
    thin edge rather than a slab, which had looked like a mistake.

    Everything sits inside the adaptive icon's safe zone, so no launcher mask
    can clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Page edge, a sliver of paper showing past the cover. -->
    <path
        android:fillColor="#F7EFDD"
        android:pathData="M76,26 h5 a3,3 0 0 1 3,3 v50 a3,3 0 0 1 -3,3 h-5 z" />

    <!-- Spine. -->
    <path
        android:fillColor="#9E1B1B"
        android:pathData="M27,24 h8 v60 h-8 a3,3 0 0 1 -3,-3 v-54 a3,3 0 0 1 3,-3 z" />

    <!-- Cover, in gold: the ground the Senyera's stripes sit on. -->
    <path
        android:fillColor="#FCD116"
        android:pathData="M35,24 h41 a3,3 0 0 1 3,3 v54 a3,3 0 0 1 -3,3 h-41 z" />

    <!-- Four red stripes of nine bands: bands 2, 4, 6 and 8. -->
    <path android:fillColor="#DA121A" android:pathData="M39.9,24 h4.9 v60 h-4.9 z" />
    <path android:fillColor="#DA121A" android:pathData="M49.7,24 h4.9 v60 h-4.9 z" />
    <path android:fillColor="#DA121A" android:pathData="M59.5,24 h4.9 v60 h-4.9 z" />
    <path android:fillColor="#DA121A" android:pathData="M69.3,24 h4.9 v60 h-4.9 z" />

    <!-- The medallion, so the bloom has something to sit against. -->
    <path
        android:fillColor="#FFF6E4"
        android:pathData="M57,54 m-19,0 a19,19 0 1 0 38,0 a19,19 0 1 0 -38,0" />

    <!-- Leaves, tucked under the bloom and inside the medallion. -->
    <path
        android:fillColor="#2E7D32"
        android:pathData="M44,64 q7,-7 13,-1.5 q-8,7 -13,1.5 z" />
    <path
        android:fillColor="#2E7D32"
        android:pathData="M70,64 q-7,-7 -13,-1.5 q8,7 13,1.5 z" />

    <!-- Bloom. -->
    <path
        android:fillColor="#E02B2B"
        android:pathData="M57,50 m-13,0 a13,13 0 1 0 26,0 a13,13 0 1 0 -26,0" />
    <!-- The furl, drawn as a spiral so the shape reads as a rose and not a dot. -->
    <path
        android:strokeColor="#9E1B1B"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M57,42 A8,8 0 1 1 49,50 A5,5 0 1 1 57,45 A2.8,2.8 0 1 0 54.2,50" />
</vector>
