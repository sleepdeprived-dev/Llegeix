<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Two layers, so the launcher's own shape is filled edge to edge.

        The background is the Senyera's red and gold, as vertical bands that
        run past every edge of the 108dp canvas: whatever shape the launcher
        cuts — Samsung's squircle, a Pixel's circle — it cuts it out of stripes,
        with no ground colour showing at the corners. The satin light across it
        is the artwork's own, lighter at the top and darker at the foot.

        The foreground is the open book and rose, cut out of the artwork and
        standing 54dp wide in the middle 72dp a launcher shows: whole through a
        circle, with stripes all round it, rather than filling the icon to its
        edges. A soft shadow of its own sits under it, because the one painted
        into the artwork fell on stripes that are not there any more.
    -->
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
