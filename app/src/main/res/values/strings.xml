    <!-- Privacy -->
    <string name="settings_privacy">Privacy</string>
    <string name="settings_privacy_open">Privacy policy</string>
    <string name="settings_privacy_summary">Llegeix collects nothing.</string>
    <string name="privacy_title">Privacy policy</string>
    <string name="privacy_body">Llegeix collects no data about you. None at all.\n\nThere is no analytics, no crash reporting, no advertising and no account. Nothing you do in this app is sent anywhere, and there is no server belonging to it to send anything to.\n\nEverything the app remembers — your folders, tags, bookmarks, saved words, reading positions and settings — is stored only on this device, in the app\'s own private storage. Uninstalling the app deletes all of it.\n\nYour PDFs are read from wherever they already are on your device. They are never copied, uploaded or opened by anything but this app.\n\nThe one time the app uses the internet is to download Google\'s ML Kit translation models, once per language, so that tapping a word can translate it. That request goes to Google and is subject to Google\'s own privacy policy; the app sends no information about you with it, and no text from your documents ever leaves the device. After the models are downloaded, translation and pronunciation work entirely offline.\n\nThe app asks for permission to read files so it can find your PDFs, and for network access solely for that model download.</string>
    <string name="privacy_updated">Last updated: 2 September 2026</string>

