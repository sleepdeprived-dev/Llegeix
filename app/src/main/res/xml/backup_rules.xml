<?xml version="1.0" encoding="utf-8"?>
<!--
    The same answer for API 30 and below, where fullBackupContent is what is
    read instead of data_extraction_rules.

    This app's minimum is API 31, so nothing on any supported device ever reads
    this file. It is written out in full anyway rather than left as the template
    it was generated from: a file that contradicts the one beside it is a trap
    for whoever lowers minSdk one day, and "it is never read" is not a thing the
    next person can see from here.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
